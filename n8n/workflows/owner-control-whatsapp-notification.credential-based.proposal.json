{
  "name": "ADOP Gate 1L-R1 — Owner Control WhatsApp Notification (Credential-Based)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://adop-demo-gema.vercel.app/api/internal/notifications/claim",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workerId: \"n8n-\" + $execution.id, leaseSeconds: 300 }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "claim-notification",
      "name": "Claim Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "ADOP Internal API Secret"
        }
      },
      "notes": "x-internal-secret header is injected by the \"ADOP Internal API Secret\" credential (hosted n8n only), not a literal value or $env expression in this workflow. Base URL is literal (adop-demo-gema.vercel.app) because the hosted BOC n8n instance denies $env access (Gate 6J-D1 finding, same reasoning already applied to gema-assistant-inbound-pair-verify.gate-6j-d5-native-crypto.json and owner-morning-brief.json)."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "has-event",
              "leftValue": "={{ $json.event }}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-event",
      "name": "Has Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{}]
        },
        "sendBody": true,
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            { "name": "target", "value": "={{ $('Claim Notification').item.json.event.recipient }}" },
            { "name": "message", "value": "={{ $('Claim Notification').item.json.event.message }}" }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "send-via-fonnte",
      "name": "Send via Fonnte (Hendro's paired device -> owner recipient)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, -80],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "ADOP Fonnte Sender Device Token"
        }
      },
      "notes": "Authorization header via the \"ADOP Fonnte Sender Device Token\" credential — never a literal token or $env expression in this file. Message text and target both come verbatim from Claim Notification's response; this node never composes, edits, or chooses either. target reads {{$json.event.recipient}} (Gate 1L-R2) — the recipient ADOP's own server resolved from the claimed event's tenant's single verified owner WhatsApp pairing (src/lib/notification-outbox/service.ts + supabase/migrations/20260811000000_notification_recipient_resolution.sql), never a number typed into this workflow. No phone number is checked in anywhere in this file."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "fonnte-ok",
              "leftValue": "={{ $json.status }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "fonnte-success",
      "name": "Fonnte Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, -80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://adop-demo-gema.vercel.app/api/internal/notifications/complete",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $('Claim Notification').item.json.event.id, workerId: \"n8n-\" + $execution.id, providerMessageId: String($json.id || '') }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "complete-notification",
      "name": "Complete Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, -160],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "ADOP Internal API Secret"
        }
      },
      "notes": "Same credential as Claim Notification and Fail Notification — one credential, three nodes, matching the existing internal-auth pattern used across gema-assistant-inbound-pair-verify.gate-6j-d5-native-crypto.json and owner-morning-brief.json."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://adop-demo-gema.vercel.app/api/internal/notifications/fail",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $('Claim Notification').item.json.event.id, workerId: \"n8n-\" + $execution.id, error: String(($json.reason || $json.message || 'fonnte send failed')).slice(0, 2000) }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "fail-notification",
      "name": "Fail Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "ADOP Internal API Secret"
        }
      },
      "notes": "Same credential as Claim Notification and Complete Notification."
    }
  ],
  "connections": {
    "Every Minute": {
      "main": [[{ "node": "Claim Notification", "type": "main", "index": 0 }]]
    },
    "Claim Notification": {
      "main": [[{ "node": "Has Event?", "type": "main", "index": 0 }]]
    },
    "Has Event?": {
      "main": [
        [{ "node": "Send via Fonnte (Hendro's paired device -> owner recipient)", "type": "main", "index": 0 }],
        []
      ]
    },
    "Send via Fonnte (Hendro's paired device -> owner recipient)": {
      "main": [[{ "node": "Fonnte Success?", "type": "main", "index": 0 }]]
    },
    "Fonnte Success?": {
      "main": [
        [{ "node": "Complete Notification", "type": "main", "index": 0 }],
        [{ "node": "Fail Notification", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
