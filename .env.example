# =============================================================================
# ADOP — Environment Contract (.env.example)
# =============================================================================
# Kontrak nama variabel environment. TIDAK berisi secret/nilai asli — isi
# sesungguhnya ada di .env.local / .env.demo.local / .env.production.local
# (semua di-gitignore, tidak boleh commit).
#
# Catatan:
# - .env.demo.local harus dimuat melalui script khusus "dev:demo"
#   (bukan auto-load Next.js seperti .env.local/.env.production.local).
# - Production sebenarnya menggunakan Environment Variables dari platform
#   hosting (mis. Vercel Production environment), bukan bergantung pada
#   file lokal.
# - Semua variabel di bawah adalah server-only KECUALI yang berprefix
#   NEXT_PUBLIC_* (ter-bundle ke client, bukan tempat secret).
# - WHATSAPP_PROVIDER masih "unconfigured" — provider WhatsApp ADOP belum
#   LOCK, jangan asumsikan Meta Cloud API, Fonnte, atau vendor lain.
# - APP_URL server-only (bukan NEXT_PUBLIC_APP_URL). APP_TIMEZONE mengatur
#   business date/day-boundary dan display; database timestamp tetap UTC.
# =============================================================================

APP_ENV=
APP_URL=
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=info
NEXT_PUBLIC_APP_NAME=ADOP
NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
WHATSAPP_PROVIDER=unconfigured
WHATSAPP_API_BASE_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_ID=
INTERNAL_API_SECRET=
CRON_SECRET=
